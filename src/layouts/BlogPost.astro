---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Link from "../components/Link.astro";
import PostMeta from "../components/PostMeta.astro";
import Tags from "../components/Tags.astro";

type ExtraProps = {
  lastModified?: Date;
};

type Props = CollectionEntry<"recipes"> & ExtraProps;

const { id, data, lastModified } = Astro.props;
const { title, description, pubDate, heroImage, tags } = data;

const editUrl = `https://github.com/zettca/recipes/edit/master/src/content/recipes/${id}.md`;

const meta = { pubDate, lastModified, editUrl };
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <main class="w-full m-0">
      <article class="prose m-auto text-lg text-pretty">
        <nav class="not-prose mb-4">
          <Link href="/" class="flex items-center gap-1 hover:underline">
            <span class="i-tabler-arrow-left" aria-hidden="true"></span>
            All recipes
          </Link>
        </nav>
        {
          heroImage ? (
            <header class="cover mb-8" transition:name={`cover-${id}`}>
              <img
                class="aspect-square md:aspect-video"
                src={heroImage}
                alt=""
              />
              <div class="cover-body">
                <Tags tags={tags} />
                <h1 class="cover-title text-4xl">{title}</h1>
                <PostMeta {...meta} class="opacity-85" />
              </div>
            </header>
          ) : (
            <header class="mb-8 grid gap-3">
              <h1 class="text-4xl m-0">{title}</h1>
              <Tags tags={tags} class="color-[var(--muted)]" />
              <PostMeta {...meta} class="color-[var(--muted)]" />
            </header>
          )
        }
        <div>
          <slot />
        </div>
      </article>
    </main>
  </body>
</html>

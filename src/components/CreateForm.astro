---
import BodyInput from "./BodyInput.astro";
import CoverInput from "./CoverInput.astro";
import Input from "./Input.astro";
---

<form id="create-form" class="grid gap-4">
  <Input required name="title" label="Title" placeholder="Mushroom Risotto" />
  <Input
    name="description"
    label="Description"
    placeholder="Risotto with mushrooms and bacon"
  />
  <Input name="tags" label="Tags" placeholder="italian, rice, yummy" />
  <CoverInput name="heroImage" />
  <BodyInput name="body" />
  <button type="submit" class="w-180px border rounded">Submit</button>
</form>

<script>
  import { kebabCase } from "change-case";
  import { parseTags, toISODate } from "../utils";

  const form = document.querySelector<HTMLFormElement>("#create-form")!;

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = Object.fromEntries(new FormData(form));
    const filename = `${kebabCase(String(data.title))}.md`;
    const value = `---
title: ${data.title}
description: ${data.description}
tags: ${parseTags(String(data.tags)).join(",")}
pubDate: ${toISODate(new Date())}
heroImage: ${String(data.heroImage ?? "").trim()}
lang: en
---

${data.body}
`;

    const searchParams = new URLSearchParams({ filename, value });
    const url = `https://github.com/zettca/recipes/new/master/src/content/recipes?${searchParams}`;

    window.open(url, "_blank");
  });
</script>

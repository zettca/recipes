---
import { getCollection, render } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Link from "../components/Link.astro";
import PostMeta from "../components/PostMeta.astro";
import Tags from "../components/Tags.astro";
import { DEFAULT_HERO, SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const posts = (await getCollection("recipes"))
  .filter((post) => !post.data.hidden)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main class="w-5xl">
      <header class="flex flex-wrap justify-between items-baseline mb-8">
        <h1>🥘 Recipes</h1>
        <p class="text-lg text-end">
          <Link href="new" class="flex items-center gap-1 hover:underline">
            <span class="i-tabler-plus" aria-hidden="true"></span> Add recipe
          </Link>
        </p>
      </header>

      <section>
        <ul class="grid list-none p-0 m-0 grid-cols-1 md:grid-cols-2 gap-8">
          {
            posts.map((post) => (
              <li
                class="md:first:col-span-2"
                transition:name={`cover-${post.id}`}
              >
                <Link href={post.id} class="cover !block">
                  <img
                    height={320}
                    src={post.data.heroImage || DEFAULT_HERO}
                    class:list={[
                      "aspect-video",
                      !post.data.heroImage && "blur-4px scale-110",
                    ]}
                    alt=""
                  />
                  <div class="cover-body">
                    <Tags tags={post.data.tags} />
                    <h2 class="cover-title text-2xl">{post.data.title}</h2>
                    <PostMeta pubDate={post.data.pubDate} class="opacity-85" />
                  </div>
                </Link>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
  </body>
</html>
